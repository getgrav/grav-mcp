{
  "name": "grav-mcp",
  "version": "0.1.4",
  "description": "MCP server for Grav CMS — AI-native content management via the Grav REST API",
  "type": "module",
  "bin": {
    "grav-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "audit:api": "tsx scripts/audit-api-coverage.ts",
    "changelog:since": "tsx scripts/changelog-since.ts",
    "check": "npm run typecheck && npm run test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "keywords": [
    "mcp",
    "grav",
    "cms",
    "ai",
    "model-context-protocol",
    "content-management"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getgrav/grav-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/getgrav/grav-mcp/issues"
  },
  "homepage": "https://github.com/getgrav/grav-mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "msw": "^2.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
